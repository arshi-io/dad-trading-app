# Virtual environments
.venv/
.venv_clean_check/
venv/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Secrets -- never commit; ANTHROPIC_API_KEY etc. are env-only
.env
.env.*
!.env.example

# Generated / runtime state -- regenerated by nightly_pipeline, not source.
# Ignore contents, not the directory itself, so .gitkeep can hold the empty
# dir in place for a fresh clone/deploy (Railway's volume mounts here too).
code/data/snapshots/*
!code/data/snapshots/.gitkeep
code/data/prices/*
!code/data/prices/.gitkeep
code/data/nifty500_constituents.csv
code/data/nifty100_constituents.csv
code/data/pairs_cointegration_cache.json
*.db

# Local run artifacts
uvicorn.log
*.log

# Dev scratch, pre-dates test_memo.py -- not part of the shipped app
/tmp_validate_memo.py
/data/

# Runtime caches (refetched automatically)
code/data/earnings_cache.json
code/data/fno_lot_sizes.json
code/data/nse_holidays.json
code/data/motilal_nse_instruments.json
code/data/history/
code/data/choice_nse_scrips.json

# Local tooling (Claude Code settings, browser-test output)
.claude/
.playwright-mcp/
