# Copy to .env and fill in. Never commit .env.

# --- Access -----------------------------------------------------------------
# bcrypt hash of the 6-digit PIN (never the raw digits). Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'123456', bcrypt.gensalt()).decode())"
APP_PIN=
# Random 64-hex string: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- AI setup review -------------------------------------------------------
MODEL_PROVIDER=openai          # openai | claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Trading mode ------------------------------------------------------------
# PAPER_TRADING (default) or ALERT_ONLY. Real execution is not a config option.
APP_MODE=PAPER_TRADING
BROKER=paper                   # paper | mock
MARKET_DATA_PROVIDER=simulated # simulated | yfinance_delayed | broker
QUOTE_STALE_SECONDS=90
LIVE_POLL_SECONDS=30

# --- Risk policy (docs/RISK_POLICY.md) ---------------------------------------
DAILY_LOSS_LIMIT_PCT=2.0
MAX_PORTFOLIO_HEAT_PCT=6.0
MAX_STOP_PCT=8.0

# --- Alerts --------------------------------------------------------------------
# Telegram: create a bot with @BotFather, then message it once and read the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=true
# Browser push (needs HTTPS or localhost). Generate a VAPID key pair once.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Choice FinX live prices (docs/BROKER_INTEGRATION.md) -------------------
# Set MARKET_DATA_PROVIDER=broker above once these are filled in. Login is automatic.
CHOICE_ENV=live                # live | uat
CHOICE_API_KEY=                # FinX portal -> Profile -> Generate API Key (locked to a static IP)
CHOICE_VENDOR_ID=              # the vendor/application name the key was generated under
CHOICE_MOBILE=                 # 10-digit mobile registered on the account
CHOICE_VENDOR_KEY=             # only if Choice issued one
CHOICE_AES_KEY=                # only if Choice issued one (32 chars)
CHOICE_AES_IV=                 # only if Choice issued one (16 chars)

# --- Motilal Oswal live prices (alternative; docs/BROKER_INTEGRATION.md) ------
# Set MARKET_DATA_PROVIDER=broker above once these are filled in.
MOTILAL_ENV=live               # live | uat (Motilal's test environment)
MOTILAL_API_KEY=
MOTILAL_API_SECRET=
MOTILAL_USERID=
MOTILAL_2FA=                   # date of birth (DD/MM/YYYY) or PAN, as set on the account
MOTILAL_CLIENT_CODE=           # dealers only; leave empty for a normal account
# Optional auto-login every weekday at 08:50. Leave empty to connect by hand on the Broker page.
MOTILAL_PASSWORD=
MOTILAL_TOTP_SECRET=           # the base32 secret behind the authenticator QR code
